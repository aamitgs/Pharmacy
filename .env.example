# Postgres connection string
DATABASE_URL="postgresql://pharmacy:pharmacy@localhost:5432/pharmacy?schema=public"

# Base URL of the deployed app
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# 32-byte key (hex or base64) used to encrypt local backup exports
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=""

# Minutes of inactivity before a session is force-logged-out
SESSION_IDLE_TIMEOUT_MINUTES="15"
