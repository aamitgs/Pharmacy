# Postgres connection string
DATABASE_URL="postgresql://pharmacy:pharmacy@localhost:5432/pharmacy?schema=public"

# Base URL of the deployed app
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# Signs the Super-Admin console's session cookie (/admin/*) — deliberately
# separate from tenant sessions. Falls back to AUTH_SECRET if unset; set a
# distinct value in production so rotating one doesn't invalidate the other.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# 32-byte key (hex or base64) used to encrypt local backup exports AND the
# reversible secrets held in the database (TOTP secrets, cloud-backup OAuth
# tokens). Generate with: openssl rand -hex 32
#
# Losing or rotating this key locks MFA users out of their accounts — they
# would have to re-enrol — and makes existing backup files unreadable. Treat
# it as being as sensitive as the database itself, and store it separately
# from the backup files.
BACKUP_ENCRYPTION_KEY=""

# Shared secret an external cron/scheduler presents to POST /api/backup/scheduled
BACKUP_CRON_SECRET=""

# Minutes of inactivity before a session is force-logged-out
SESSION_IDLE_TIMEOUT_MINUTES="15"

# Local-disk directory for uploaded prescription images (Schedule H/H1/X sales).
# Defaults to ./storage/prescriptions if unset. Must be outside `public/` —
# files are only readable through the authenticated /api/files/prescriptions route.
PRESCRIPTION_STORAGE_DIR=""

# WhatsApp receipt/statement delivery (Gupshup). Leave unset to run with
# WhatsApp sending disabled — the "Send via WhatsApp" button will report
# "not configured" instead of crashing. See README for setup steps.
GUPSHUP_API_KEY=""
GUPSHUP_SOURCE_NUMBER=""
GUPSHUP_APP_NAME=""

# E-invoice (IRN/QR) and e-way bill generation, via a GSP (GST Suvidha
# Provider) API compatible with the NIC IRP schema. Leave unset to run with
# generation disabled — attempts log "not configured" instead of crashing.
# See README for setup steps.
GSP_BASE_URL=""
GSP_API_KEY=""
GSP_SELLER_GSTIN=""

# Razorpay subscription billing (Settings > Billing plan upgrades). Leave
# unset to run with checkout disabled — the upgrade button reports "not
# configured" instead of crashing. See README for setup steps, including
# creating one Razorpay Plan per priced SubscriptionPlan tier.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cloud backup (Settings > Backup). Leave either pair unset to run with that
# destination's Connect button disabled — reports "not configured" instead
# of crashing. Redirect URI to register: <NEXTAUTH_URL>/api/oauth/google-drive/callback
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
# Redirect URI to register: <NEXTAUTH_URL>/api/oauth/onedrive/callback
ONEDRIVE_CLIENT_ID=""
ONEDRIVE_CLIENT_SECRET=""

# Shared secret an external cron/scheduler presents to POST /api/refill-reminders/scheduled
REFILL_REMINDERS_CRON_SECRET=""

# Owner mobile PWA push notifications (Settings > Notifications). Leave
# unset to run with push disabled — the Enable button reports "not
# configured" instead of crashing. Generate a pair with:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: link or https: URL identifying you to
# push services, e.g. mailto:ops@example.com
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Shared secret an external cron/scheduler presents to POST /api/push/scheduled
PUSH_NOTIFICATIONS_CRON_SECRET=""

# Error tracking + performance monitoring (Phase 11.1/11.4). Works against
# either Sentry.io or a self-hosted GlitchTip instance — same DSN either
# way, GlitchTip speaks the same ingestion protocol. Leave unset to run
# with error tracking disabled. SENTRY_DSN is read server-side only;
# NEXT_PUBLIC_SENTRY_DSN ships in the browser bundle, so only set it to a
# value you're fine being publicly visible (a DSN is a write-only ingest
# endpoint, not a secret, but keep the two in sync if you set both).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Fraction of requests/transactions to trace (0.0-1.0). 0.1 = 10%.
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# Structured operational logging (Phase 11.2). Always plain JSON on stdout
# (see src/lib/logger.ts for why) — for colorized dev output, pipe through
# pino-pretty instead: `npm run dev | npx pino-pretty`.
LOG_LEVEL="info"

# Phase 11.4: log any database query slower than this many milliseconds
# (structured, via LOG_LEVEL="warn"+, action: "db.slow_query") — real APM
# signal for report/analytics screens under load, not a guess.
SLOW_QUERY_THRESHOLD_MS="500"
