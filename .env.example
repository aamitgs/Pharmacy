# Postgres connection string
DATABASE_URL="postgresql://pharmacy:pharmacy@localhost:5432/pharmacy?schema=public"

# Base URL of the deployed app
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# Signs the Super-Admin console's session cookie (/admin/*) — deliberately
# separate from tenant sessions. Falls back to AUTH_SECRET if unset; set a
# distinct value in production so rotating one doesn't invalidate the other.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# 32-byte key (hex or base64) used to encrypt local backup exports
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=""

# Shared secret an external cron/scheduler presents to POST /api/backup/scheduled
BACKUP_CRON_SECRET=""

# Minutes of inactivity before a session is force-logged-out
SESSION_IDLE_TIMEOUT_MINUTES="15"

# Local-disk directory for uploaded prescription images (Schedule H/H1/X sales).
# Defaults to ./storage/prescriptions if unset. Must be outside `public/` —
# files are only readable through the authenticated /api/files/prescriptions route.
PRESCRIPTION_STORAGE_DIR=""

# WhatsApp receipt/statement delivery (Gupshup). Leave unset to run with
# WhatsApp sending disabled — the "Send via WhatsApp" button will report
# "not configured" instead of crashing. See README for setup steps.
GUPSHUP_API_KEY=""
GUPSHUP_SOURCE_NUMBER=""
GUPSHUP_APP_NAME=""

# E-invoice (IRN/QR) and e-way bill generation, via a GSP (GST Suvidha
# Provider) API compatible with the NIC IRP schema. Leave unset to run with
# generation disabled — attempts log "not configured" instead of crashing.
# See README for setup steps.
GSP_BASE_URL=""
GSP_API_KEY=""
GSP_SELLER_GSTIN=""

# Razorpay subscription billing (Settings > Billing plan upgrades). Leave
# unset to run with checkout disabled — the upgrade button reports "not
# configured" instead of crashing. See README for setup steps, including
# creating one Razorpay Plan per priced SubscriptionPlan tier.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cloud backup (Settings > Backup). Leave either pair unset to run with that
# destination's Connect button disabled — reports "not configured" instead
# of crashing. Redirect URI to register: <NEXTAUTH_URL>/api/oauth/google-drive/callback
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
# Redirect URI to register: <NEXTAUTH_URL>/api/oauth/onedrive/callback
ONEDRIVE_CLIENT_ID=""
ONEDRIVE_CLIENT_SECRET=""

# Shared secret an external cron/scheduler presents to POST /api/refill-reminders/scheduled
REFILL_REMINDERS_CRON_SECRET=""
