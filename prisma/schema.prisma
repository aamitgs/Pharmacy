// Pharmacy Management & Billing System — Phase 1
// Every business table carries tenantId from day one so a later
// multi-tenancy phase never requires a retrofit migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenant / Branch
// ---------------------------------------------------------------------------

model Tenant {
  id                            String    @id @default(cuid())
  pharmacyName                  String
  tenantType                    String    @default("retail")
  logoUrl                       String?
  primaryColor                  String?
  invoiceFooterText             String?
  // Staff discount cap: discounts above this % require a manager PIN override.
  staffDiscountCapPercent       Decimal   @default(10) @db.Decimal(5, 2)
  managerPinHash                String?
  nearExpiryWindowDays          Int       @default(90)
  // Separate from nearExpiryWindowDays (batch stock expiry) — licence
  // renewal lead time is a different business concern with its own
  // sensible default.
  licenseExpiryWindowDays       Int       @default(60)
  // Set by a super-admin (see SuperAdmin) to lock a tenant out of sign-in —
  // a suspended tenant's own users can no longer authenticate. Independent
  // of subscription status: billing gates *usage*, suspension gates
  // *access* entirely (abuse/compliance, not non-payment).
  suspendedAt                   DateTime?
  // White-labeling — gated to plans with SubscriptionPlan.whiteLabel=true
  // (checked in the settings action, not enforced at the DB level since a
  // downgrade shouldn't silently wipe a tenant's saved domain).
  customDomain                  String?   @unique
  customDomainVerificationToken String?
  customDomainVerifiedAt        DateTime?
  createdAt                     DateTime  @default(now())

  branches      Branch[]
  items         Item[]
  customers     Customer[]
  doctors       Doctor[]
  salesInvoices SalesInvoice[]
  discounts     Discount[]
  users         User[]
  auditLogs     AuditLog[]
  backupLogs    BackupLog[]

  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  grns                  Grn[]
  purchaseReturns       PurchaseReturn[]
  supplierLedgerEntries SupplierLedgerEntry[]
  stockTransfers        StockTransfer[]

  narcoticRegisterEntries NarcoticRegisterEntry[]

  schemes      Scheme[]
  loyaltyTiers LoyaltyTier[]
  coupons      Coupon[]

  customerLedgerEntries CustomerLedgerEntry[]
  whatsappLogs          WhatsAppLog[]

  subscription TenantSubscription?
  apiKeys      ApiKey[]

  wards             Ward[]
  wardAssignments   WardAssignment[]
  indents           Indent[]
  patientAdmissions PatientAdmission[]
  ipdDispenses      IpdDispense[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Subscription & billing — Phase 6
// ---------------------------------------------------------------------------

// A shared catalog, not tenant data — deliberately has no tenantId and no
// RLS policy (every tenant needs to read the same plan list to self-serve
// signup/upgrade). Only trusted internal code (via the bypass flag) writes
// to it; there's no tenant-facing mutation path.
model SubscriptionPlan {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  priceMonthly     Decimal  @db.Decimal(10, 2)
  maxBranches      Int?
  maxUsers         Int?
  whiteLabel       Boolean  @default(false)
  publicApiAccess  Boolean  @default(false)
  // Enterprise-tier plans skip self-serve Razorpay checkout entirely — the
  // signup/upgrade UI shows a "Talk to sales" CTA instead of a pay button.
  contactSalesOnly Boolean  @default(false)
  // Razorpay's own recurring-billing plan id, created once in the Razorpay
  // dashboard/API per priced tier. Null for the trial tier (no billing) and
  // for the enterprise tier (billed manually, outside Razorpay).
  razorpayPlanId   String?
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

enum TenantSubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

model TenantSubscription {
  id                     String                   @id @default(cuid())
  tenantId               String                   @unique
  planId                 String
  status                 TenantSubscriptionStatus @default(trialing)
  razorpayCustomerId     String?
  razorpaySubscriptionId String?                  @unique
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([planId])
  @@map("tenant_subscriptions")
}

model Branch {
  id                       String   @id @default(cuid())
  tenantId                 String
  name                     String
  licensedAddress          String
  gstin                    String?
  pan                      String?
  drugLicenseRetailNo      String?
  drugLicenseWholesaleNo   String?
  pharmacistName           String?
  pharmacistRegistrationNo String?
  narcoticLicenseNo        String?
  fssaiNo                  String?
  // Keyed by license type (retail, wholesale, narcotic, fssai) -> ISO date
  // string. jsonb rather than one column per license so the Alerts screen's
  // "renewals due soon" scan and the Settings form can both iterate it
  // generically instead of hard-coding a column per license type.
  licenseExpiryDates       Json?
  // A branch-level toggle stands in for a turnover-threshold check — the
  // real GST e-invoice turnover threshold is government policy that
  // changes over time, so it's not hardcoded; an owner flips this on once
  // the branch is actually liable for e-invoicing.
  einvoiceEnabled          Boolean  @default(false)
  // Per-invoice/GRN value threshold above which an e-way bill is
  // auto-attempted. Configurable per branch (state-level e-way bill rules
  // vary), not hardcoded to the common ₹50,000 default.
  ewayBillThreshold        Decimal  @default(50000) @db.Decimal(12, 2)
  createdAt                DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesInvoices   SalesInvoice[]
  purchaseOrders  PurchaseOrder[]
  grns            Grn[]
  batches         Batch[]
  purchaseReturns PurchaseReturn[]

  narcoticRegisterEntries NarcoticRegisterEntry[]
  stockTransfersFrom      StockTransfer[]         @relation("StockTransferFrom")
  stockTransfersTo        StockTransfer[]         @relation("StockTransferTo")

  wards Ward[]

  @@index([tenantId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Item / Batch master
// ---------------------------------------------------------------------------

enum ScheduleClass {
  none
  H
  H1
  X
  G
}

model Item {
  id            String        @id @default(cuid())
  tenantId      String
  name          String
  genericName   String?
  manufacturer  String?
  composition   String?
  scheduleClass ScheduleClass @default(none)
  hsnCode       String?
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  unit          String        @default("unit")
  packSize      String?
  reorderLevel  Int           @default(10)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches             Batch[]
  salesInvoiceItems   SalesInvoiceItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  grnItems            GrnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  stockTransferItems  StockTransferItem[]
  indentItems         IndentItem[]
  ipdDispenses        IpdDispense[]

  narcoticRegisterEntries NarcoticRegisterEntry[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@map("items")
}

model Batch {
  id           String    @id @default(cuid())
  itemId       String
  // A batch is physically at one branch — it's the GRN that received it (or
  // a stock transfer) that pins it there. The same batch number can exist
  // as separate Batch rows at different branches; a transfer creates a new
  // row at the destination rather than splitting one row across branches.
  branchId     String
  // Phase 7 (Hospital Mode): null means this row is central/branch-level
  // stock (the only case for a retail tenant). Set means this row is
  // ward-scoped stock within that same branch — the same "new row at the
  // destination, never split across locations" principle as branchId
  // above, just one level deeper. An indent issue creates/updates the
  // ward's own Batch row rather than moving the central one.
  wardId       String?
  batchNo      String
  mfgDate      DateTime?
  expiryDate   DateTime
  mrp          Decimal   @db.Decimal(10, 2)
  purchaseRate Decimal   @db.Decimal(10, 2)
  saleRate     Decimal   @db.Decimal(10, 2)
  currentQty   Int       @default(0)
  rackLocation String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  item                Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch              Branch               @relation(fields: [branchId], references: [id])
  ward                Ward?                @relation(fields: [wardId], references: [id])
  salesInvoiceItems   SalesInvoiceItem[]
  grnItems            GrnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  stockTransferItems  StockTransferItem[]
  indentItems         IndentItem[]
  ipdDispenses        IpdDispense[]

  narcoticRegisterEntries NarcoticRegisterEntry[]

  @@index([itemId])
  @@index([itemId, expiryDate])
  @@index([branchId])
  @@index([branchId, itemId, batchNo])
  @@index([wardId])
  @@index([wardId, itemId, batchNo])
  @@map("batches")
}

// ---------------------------------------------------------------------------
// Customer / Doctor
// ---------------------------------------------------------------------------

model Customer {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String
  phone              String?
  creditLimit        Decimal? @db.Decimal(10, 2)
  // Cached for convenience only — never written to directly by app code.
  // The real balance is always SUM(CustomerLedgerEntry.amount) for this
  // customer (credit sales positive, payments negative); see
  // src/lib/actions/customers.ts.
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  // Loyalty tier is computed/reassigned automatically whenever
  // cumulativeSpend crosses a tier threshold (see resolveLoyaltyTier in
  // src/lib/actions/pos.ts) — never set directly through a form.
  loyaltyTierId      String?
  cumulativeSpend    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loyaltyTier   LoyaltyTier?          @relation(fields: [loyaltyTierId], references: [id])
  salesInvoices SalesInvoice[]
  ledgerEntries CustomerLedgerEntry[]
  whatsappLogs  WhatsAppLog[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([loyaltyTierId])
  @@map("customers")
}

enum WhatsAppMessageType {
  receipt
  statement
  reminder
}

enum WhatsAppStatus {
  sent
  failed
}

model WhatsAppLog {
  id          String              @id @default(cuid())
  tenantId    String
  customerId  String?
  invoiceId   String?
  phone       String
  messageType WhatsAppMessageType
  status      WhatsAppStatus
  // Provider error text, or "not configured" when no WhatsApp API
  // credentials are set — kept distinct from `status` so the UI can show
  // staff *why* a send failed, not just that it did.
  note        String?
  sentAt      DateTime            @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id])
  invoice  SalesInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@index([invoiceId])
  @@map("whatsapp_logs")
}

enum CustomerLedgerEntryType {
  sale
  payment
}

model CustomerLedgerEntry {
  id            String                  @id @default(cuid())
  tenantId      String
  customerId    String
  type          CustomerLedgerEntryType
  // Signed: credit sales are positive (increase what they owe), payments
  // are negative (decrease what they owe). Outstanding balance for a
  // customer is simply SUM(amount) over their entries.
  amount        Decimal                 @db.Decimal(12, 2)
  referenceId   String?
  referenceType String?
  note          String?
  createdAt     DateTime                @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId, createdAt])
  @@map("customer_ledger_entries")
}

enum SchemeType {
  percent_off
  buy_x_get_y
}

// config jsonb holds type-specific rules:
//   percent_off  -> { percent: number, applicableItemIds?: string[] }
//   buy_x_get_y  -> { buyQty: number, getQty: number, applicableItemIds: string[] }
// An empty/omitted applicableItemIds on percent_off means "all items".
model Scheme {
  id        String     @id @default(cuid())
  tenantId  String
  name      String
  type      SchemeType
  config    Json
  validFrom DateTime
  validTo   DateTime
  active    Boolean    @default(true)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discounts Discount[]

  @@index([tenantId])
  @@index([tenantId, active])
  @@map("schemes")
}

model LoyaltyTier {
  id                 String  @id @default(cuid())
  tenantId           String
  name               String
  minCumulativeSpend Decimal @db.Decimal(12, 2)
  discountPercent    Decimal @db.Decimal(5, 2)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@index([tenantId])
  @@map("loyalty_tiers")
}

enum CouponType {
  percent
  flat
}

model Coupon {
  id                   String     @id @default(cuid())
  tenantId             String
  code                 String
  type                 CouponType
  value                Decimal    @db.Decimal(10, 2)
  validFrom            DateTime
  validTo              DateTime
  usageLimit           Int?
  usageCount           Int        @default(0)
  singleUsePerCustomer Boolean    @default(false)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discounts Discount[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("coupons")
}

model Doctor {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  registrationNo String?
  clinicName     String?
  createdAt      DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesInvoices SalesInvoice[]

  narcoticRegisterEntries NarcoticRegisterEntry[]

  @@index([tenantId])
  @@map("doctors")
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

enum PaymentMode {
  cash
  upi
  card
  credit
}

enum InvoiceStatus {
  completed
  cancelled
}

model SalesInvoice {
  id                      String        @id @default(cuid())
  tenantId                String
  branchId                String
  customerId              String?
  doctorId                String?
  patientName             String?
  patientAge              Int?
  invoiceNo               String
  invoiceDate             DateTime      @default(now())
  // Client-generated UUID set only for a sale that was queued offline and
  // synced later — lets a retried sync (e.g. the network drops again right
  // after the server commits but before the client sees the response)
  // replay safely instead of double-billing. Null for every sale rung up
  // while online.
  offlineClientId         String?       @unique
  subtotal                Decimal       @db.Decimal(12, 2)
  taxAmount               Decimal       @db.Decimal(12, 2)
  discountAmount          Decimal       @default(0) @db.Decimal(12, 2)
  total                   Decimal       @db.Decimal(12, 2)
  paymentMode             PaymentMode
  status                  InvoiceStatus @default(completed)
  // Scan/photo of the physical prescription, attached for Schedule H/H1/X
  // sales. Optional — capture is encouraged, not enforced, per spec.
  prescriptionImageUrl    String?
  // The specific Pharmacist-role user who electronically signed off on a
  // regulated-drug dispense, separate from whichever Counter Staff user
  // actually rang up the sale (session.user.id if a Pharmacist is at the
  // till; the re-authenticating pharmacist's id otherwise). Null for
  // invoices with no Schedule H/H1/X lines.
  pharmacistSignoffUserId String?
  pharmacistSignoffAt     DateTime?
  // Populated asynchronously after the sale completes — a failed/slow GSP
  // call must never block or fail the checkout transaction itself. Null
  // until (and unless) generation succeeds; a manual retry action is
  // available from the receipt screen.
  einvoiceIrn             String?
  einvoiceAckNo           String?
  // The signed QR payload string returned by the IRP — rendered as an
  // actual QR image client-side (via the `qrcode` package already used for
  // MFA setup), not stored as an image.
  einvoiceQrData          String?
  ewayBillNo              String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch    @relation(fields: [branchId], references: [id])
  customer          Customer? @relation(fields: [customerId], references: [id])
  doctor            Doctor?   @relation(fields: [doctorId], references: [id])
  pharmacistSignoff User?     @relation("SalesInvoicePharmacistSignoff", fields: [pharmacistSignoffUserId], references: [id])

  items                   SalesInvoiceItem[]
  discounts               Discount[]
  narcoticRegisterEntries NarcoticRegisterEntry[]
  whatsappLogs            WhatsAppLog[]

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, invoiceDate])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  itemId         String
  batchId        String
  qty            Int
  rate           Decimal @db.Decimal(10, 2)
  taxRate        Decimal @db.Decimal(5, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)

  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item      Item         @relation(fields: [itemId], references: [id])
  batch     Batch        @relation(fields: [batchId], references: [id])
  discounts Discount[]

  @@index([invoiceId])
  @@index([itemId])
  @@index([batchId])
  @@map("sales_invoice_items")
}

enum DiscountType {
  item
  bill
  scheme
  loyalty
  coupon
}

model Discount {
  id               String       @id @default(cuid())
  tenantId         String
  invoiceId        String
  invoiceItemId    String?
  type             DiscountType
  // The rate as entered/configured — a percent or a flat rupee value per
  // isPercent. Kept for audit ("what was typed/configured"), but NOT the
  // actual rupee amount applied (which can differ after capping when
  // multiple bill-level discounts stack) — use `amount` for that.
  amountOrPercent  Decimal      @db.Decimal(10, 2)
  isPercent        Boolean      @default(true)
  // The actual rupee amount this discount contributed to the sale, after
  // any stacking/capping — what the discount report sums.
  amount           Decimal      @default(0) @db.Decimal(10, 2)
  // Set only when type is "scheme" / "coupon" respectively — links the
  // discount row back to the offer that produced it, for reporting.
  schemeId         String?
  couponId         String?
  appliedByUserId  String
  approvedByUserId String?
  createdAt        DateTime     @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     SalesInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItem SalesInvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  scheme      Scheme?           @relation(fields: [schemeId], references: [id])
  coupon      Coupon?           @relation(fields: [couponId], references: [id])
  appliedBy   User              @relation("DiscountAppliedBy", fields: [appliedByUserId], references: [id])
  approvedBy  User?             @relation("DiscountApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@index([schemeId])
  @@index([couponId])
  @@map("discounts")
}

// ---------------------------------------------------------------------------
// Users / Auth
// ---------------------------------------------------------------------------

enum UserRole {
  owner
  pharmacist
  counter_staff
  // Phase 7 (Hospital Mode) — only assignable/reachable on a tenant with
  // tenantType 'hospital'. ward_nurse: creates Indents and records IPD
  // dispenses/returns for their assigned ward(s) only, no access to
  // purchasing or retail billing. ward_pharmacist: approves/issues
  // Indents, and everywhere the existing "pharmacist" role is checked
  // (rbac.ts, POS prescription sign-off) it is treated identically — a
  // hospital's central/OPD pharmacist, not a separate permission set.
  ward_nurse
  ward_pharmacist
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String
  role         UserRole
  phone        String?
  licenseNo    String?
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs         AuditLog[]
  discountsApplied  Discount[] @relation("DiscountAppliedBy")
  discountsApproved Discount[] @relation("DiscountApprovedBy")

  purchaseOrdersCreated  PurchaseOrder[]  @relation("PurchaseOrderCreatedBy")
  grnsReceived           Grn[]            @relation("GrnReceivedBy")
  purchaseReturnsCreated PurchaseReturn[] @relation("PurchaseReturnCreatedBy")

  salesInvoicesSignedOff   SalesInvoice[]          @relation("SalesInvoicePharmacistSignoff")
  narcoticEntriesDispensed NarcoticRegisterEntry[] @relation("NarcoticEntryDispensedBy")

  stockTransfersRequested StockTransfer[] @relation("StockTransferRequestedBy")
  stockTransfersApproved  StockTransfer[] @relation("StockTransferApprovedBy")

  wardAssignments      WardAssignment[]
  indentsRequested     Indent[]         @relation("IndentRequestedBy")
  indentsApproved      Indent[]         @relation("IndentApprovedBy")
  ipdDispensesRecorded IpdDispense[]    @relation("IpdDispenseDispensedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Audit / Backup
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

enum BackupDestination {
  local
  manual
}

enum BackupStatus {
  success
  failed
}

model BackupLog {
  id          String            @id @default(cuid())
  tenantId    String
  destination BackupDestination
  status      BackupStatus
  createdAt   DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("backup_logs")
}

// ---------------------------------------------------------------------------
// Purchase & Inventory — Phase 2
// ---------------------------------------------------------------------------

model Supplier {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String
  gstin              String?
  address            String?
  paymentTermsDays   Int?
  // Cached for convenience only — never written to directly by app code.
  // The real balance is always SUM(SupplierLedgerEntry.amount) for this
  // supplier (purchases positive, payments/returns negative); see
  // src/lib/actions/suppliers.ts.
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]
  grns            Grn[]
  purchaseReturns PurchaseReturn[]
  ledgerEntries   SupplierLedgerEntry[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  draft
  sent
  received
  cancelled
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  tenantId        String
  branchId        String
  supplierId      String
  status          PurchaseOrderStatus @default(draft)
  createdAt       DateTime            @default(now())
  createdByUserId String

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id])
  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User     @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id])

  items PurchaseOrderItem[]
  grns  Grn[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  itemId          String
  qty             Int
  rate            Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model Grn {
  id                  String   @id @default(cuid())
  tenantId            String
  // Which branch physically received the goods — new in Phase 4. Backfilled
  // for existing rows to the tenant's pre-Phase-4 single branch.
  branchId            String
  purchaseOrderId     String?
  supplierId          String
  supplierInvoiceNo   String
  supplierInvoiceDate DateTime
  receivedAt          DateTime @default(now())
  receivedByUserId    String
  ewayBillNo          String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  receivedBy    User           @relation("GrnReceivedBy", fields: [receivedByUserId], references: [id])

  items           GrnItem[]
  purchaseReturns PurchaseReturn[]

  @@index([tenantId])
  @@index([tenantId, receivedAt])
  @@index([purchaseOrderId])
  @@index([branchId])
  @@map("grns")
}

model GrnItem {
  id         String    @id @default(cuid())
  grnId      String
  itemId     String
  // Set in the same transaction that creates/updates the Batch this row
  // resulted in — a GrnItem never exists without its Batch being real.
  batchId    String
  batchNo    String
  mfgDate    DateTime?
  expiryDate DateTime
  mrp        Decimal   @db.Decimal(10, 2)
  rate       Decimal   @db.Decimal(10, 2)
  qty        Int

  grn   Grn   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item  Item  @relation(fields: [itemId], references: [id])
  batch Batch @relation(fields: [batchId], references: [id])

  @@index([grnId])
  @@index([itemId])
  @@map("grn_items")
}

model PurchaseReturn {
  id              String   @id @default(cuid())
  tenantId        String
  // Which branch's stock this return decrements — new in Phase 4,
  // backfilled for existing rows from the tenant's pre-Phase-4 single
  // branch. Independent of grnId since a return can be standalone.
  branchId        String
  grnId           String?
  supplierId      String
  returnDate      DateTime @default(now())
  reason          String?
  totalAmount     Decimal  @db.Decimal(12, 2)
  createdByUserId String

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id])
  grn       Grn?     @relation(fields: [grnId], references: [id])
  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User     @relation("PurchaseReturnCreatedBy", fields: [createdByUserId], references: [id])

  items PurchaseReturnItem[]

  @@index([tenantId])
  @@index([tenantId, returnDate])
  @@index([grnId])
  @@index([branchId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String  @id @default(cuid())
  purchaseReturnId String
  itemId           String
  batchId          String
  qty              Int
  rate             Decimal @db.Decimal(10, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  item           Item           @relation(fields: [itemId], references: [id])
  batch          Batch          @relation(fields: [batchId], references: [id])

  @@index([purchaseReturnId])
  @@map("purchase_return_items")
}

enum SupplierLedgerEntryType {
  purchase
  payment
  return
}

model SupplierLedgerEntry {
  id            String                  @id @default(cuid())
  tenantId      String
  supplierId    String
  type          SupplierLedgerEntryType
  // Signed: purchases are positive (increase what we owe), payments and
  // returns are negative (decrease what we owe). Outstanding balance for a
  // supplier is simply SUM(amount) over their entries.
  amount        Decimal                 @db.Decimal(12, 2)
  referenceId   String?
  referenceType String?
  note          String?
  createdAt     DateTime                @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([supplierId, createdAt])
  @@map("supplier_ledger_entries")
}

// ---------------------------------------------------------------------------
// Multi-branch — Phase 4
// ---------------------------------------------------------------------------

enum StockTransferStatus {
  pending
  approved
  completed
  rejected
}

// Manual request/approve flow between two branches of the same tenant.
// fromBranch is the source (fulfilling) branch; toBranch is the branch that
// requested stock. Approval and stock movement happen atomically in the
// same action — "approved" stays a defined status for the audit trail, but
// a transfer moves straight from pending to completed rather than resting
// in "approved" first; there is no separate ship/receive step in this MVP.
model StockTransfer {
  id                String              @id @default(cuid())
  tenantId          String
  fromBranchId      String
  toBranchId        String
  status            StockTransferStatus @default(pending)
  requestedByUserId String
  approvedByUserId  String?
  createdAt         DateTime            @default(now())
  completedAt       DateTime?

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranch  Branch @relation("StockTransferFrom", fields: [fromBranchId], references: [id])
  toBranch    Branch @relation("StockTransferTo", fields: [toBranchId], references: [id])
  requestedBy User   @relation("StockTransferRequestedBy", fields: [requestedByUserId], references: [id])
  approvedBy  User?  @relation("StockTransferApprovedBy", fields: [approvedByUserId], references: [id])

  items StockTransferItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String @id @default(cuid())
  transferId String
  itemId     String
  batchId    String
  qty        Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     Item          @relation(fields: [itemId], references: [id])
  batch    Batch         @relation(fields: [batchId], references: [id])

  @@index([transferId])
  @@map("stock_transfer_items")
}

// ---------------------------------------------------------------------------
// Compliance — Phase 3
// ---------------------------------------------------------------------------

// Tamper-evident narcotic (Schedule X) dispense register. Insert-only at the
// application level — no update/delete server actions exist for this model.
// A correction is a second row with reversalOfId pointing at the original;
// the original itself is never edited or removed.
model NarcoticRegisterEntry {
  id                String   @id @default(cuid())
  tenantId          String
  branchId          String
  invoiceId         String
  itemId            String
  batchId           String
  qty               Int
  doctorId          String?
  patientName       String?
  dispensedByUserId String
  dispensedAt       DateTime @default(now())
  // Present only on a reversal row; points at the entry it corrects. Unique
  // so an original can be reversed at most once.
  reversalOfId      String?  @unique

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [branchId], references: [id])
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id])
  item        Item         @relation(fields: [itemId], references: [id])
  batch       Batch        @relation(fields: [batchId], references: [id])
  doctor      Doctor?      @relation(fields: [doctorId], references: [id])
  dispensedBy User         @relation("NarcoticEntryDispensedBy", fields: [dispensedByUserId], references: [id])

  reversalOf NarcoticRegisterEntry? @relation("NarcoticEntryReversal", fields: [reversalOfId], references: [id])
  reversedBy NarcoticRegisterEntry? @relation("NarcoticEntryReversal")

  @@index([tenantId])
  @@index([tenantId, dispensedAt])
  @@index([invoiceId])
  @@map("narcotic_register_entries")
}

// ---------------------------------------------------------------------------
// Platform staff & public API — Phase 6
// ---------------------------------------------------------------------------

// Platform operator, not a tenant user — deliberately has no tenantId and
// sits outside the RLS system entirely (there is no tenant to scope to).
// Authenticated through a completely separate session mechanism from
// tenant users (see src/lib/admin-auth.ts) so a compromised tenant session
// can never reach this table or its console.
model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("super_admins")
}

// A generated key for the versioned public REST API (/api/v1/...). Only the
// SHA-256 hash is stored — the plaintext key is shown once, at creation
// time, the same way GitHub/Stripe-style API keys work.
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  keyHash    String    @unique
  // First few characters of the plaintext key, kept only for the tenant to
  // recognize which key is which in a list — never enough to reconstruct it.
  keyPrefix  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// Hospital Mode — Phase 7
//
// A tenant-level toggle (Tenant.tenantType), not a fork of the product: a
// retail tenant never has rows in any table below, and every route/nav item
// that reaches them is unreachable (notFound(), not just hidden) unless
// tenantType is 'hospital'. A hospital's OPD counter keeps using the exact
// same POS/SalesInvoice path as retail; everything here is the IPD side on
// top of it.
// ---------------------------------------------------------------------------

enum WardType {
  icu
  ot
  general
  pharmacy_substore
}

// A Ward is effectively its own small stock location one level deeper than
// Branch (see Batch.wardId) — created under a Branch, never spanning branches.
model Ward {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  type      WardType
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  batches           Batch[]
  wardAssignments   WardAssignment[]
  indents           Indent[]
  patientAdmissions PatientAdmission[]

  @@index([tenantId])
  @@index([branchId])
  @@map("wards")
}

// Which ward(s) a Ward Nurse (or Ward/Duty Pharmacist) is assigned to —
// server-side enforcement point for "a nurse assigned to ICU cannot see or
// act on General Ward data". Owner/Pharmacist/Ward Pharmacist are not
// restricted by this table; it only narrows ward_nurse.
model WardAssignment {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  wardId   String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ward   Ward   @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([userId, wardId])
  @@index([tenantId])
  @@index([userId])
  @@index([wardId])
  @@map("ward_assignments")
}

enum IndentStatus {
  pending
  approved
  partially_issued
  issued
  rejected
}

// Ward-side stock request, approved/issued by the central pharmacy. Modeled
// on StockTransfer (Phase 4) — the difference is a nurse requests an item
// and quantity, not a specific batch; the pharmacist picks the batch (FEFO,
// with override) at issue time.
model Indent {
  id                String       @id @default(cuid())
  tenantId          String
  wardId            String
  requestedByUserId String
  status            IndentStatus @default(pending)
  createdAt         DateTime     @default(now())
  approvedByUserId  String?
  approvedAt        DateTime?

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward        Ward   @relation(fields: [wardId], references: [id])
  requestedBy User   @relation("IndentRequestedBy", fields: [requestedByUserId], references: [id])
  approvedBy  User?  @relation("IndentApprovedBy", fields: [approvedByUserId], references: [id])

  items IndentItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([wardId])
  @@map("indents")
}

model IndentItem {
  id           String  @id @default(cuid())
  indentId     String
  itemId       String
  // Null at request time (a nurse requests an item, not a specific batch).
  // Filled in at issue time with the *source* (central) batch FEFO-selected
  // to fulfill this line, for traceability — matches how GrnItem/
  // StockTransferItem/SalesInvoiceItem all reference the batch a
  // transaction actually moved stock against.
  batchId      String?
  qtyRequested Int
  qtyIssued    Int     @default(0)

  indent Indent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id])
  batch  Batch? @relation(fields: [batchId], references: [id])

  @@index([indentId])
  @@index([itemId])
  @@map("indent_items")
}

// Deliberately minimal — not an EMR. Just enough to tag IPD dispenses to a
// real patient/stay; an external HIS is what builds the actual hospital
// bill from the consumption records this produces (see IpdDispense).
model PatientAdmission {
  id           String    @id @default(cuid())
  tenantId     String
  admissionRef String
  patientName  String
  wardId       String
  admittedAt   DateTime  @default(now())
  dischargedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward   Ward   @relation(fields: [wardId], references: [id])

  dispenses IpdDispense[]

  @@unique([tenantId, admissionRef])
  @@index([tenantId])
  @@index([wardId])
  @@map("patient_admissions")
}

// A consumption record against an admission, dispensed directly from the
// ward's own stock (no separate transfer step, same discipline as POS
// completeSale decrementing its branch's Batch directly). Does NOT create a
// SalesInvoice — IPD consumption feeds an external HIS's own bill, not this
// app's billing. returnedQty supports the unused-medicine return workflow
// without a separate return entity.
model IpdDispense {
  id                String   @id @default(cuid())
  tenantId          String
  admissionId       String
  itemId            String
  batchId           String
  qty               Int
  dispensedByUserId String
  dispensedAt       DateTime @default(now())
  returnedQty       Int      @default(0)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admission   PatientAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  item        Item             @relation(fields: [itemId], references: [id])
  batch       Batch            @relation(fields: [batchId], references: [id])
  dispensedBy User             @relation("IpdDispenseDispensedBy", fields: [dispensedByUserId], references: [id])

  @@index([tenantId])
  @@index([admissionId])
  @@map("ipd_dispenses")
}
