// Pharmacy Management & Billing System — Phase 1
// Every business table carries tenantId from day one so a later
// multi-tenancy phase never requires a retrofit migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenant / Branch
// ---------------------------------------------------------------------------

model Tenant {
  id                            String    @id @default(cuid())
  pharmacyName                  String
  tenantType                    String    @default("retail")
  logoUrl                       String?
  primaryColor                  String?
  invoiceFooterText             String?
  // Staff discount cap: discounts above this % require a manager PIN override.
  staffDiscountCapPercent       Decimal   @default(10) @db.Decimal(5, 2)
  managerPinHash                String?
  nearExpiryWindowDays          Int       @default(90)
  // Separate from nearExpiryWindowDays (batch stock expiry) — licence
  // renewal lead time is a different business concern with its own
  // sensible default.
  licenseExpiryWindowDays       Int       @default(60)
  // Set by a super-admin (see SuperAdmin) to lock a tenant out of sign-in —
  // a suspended tenant's own users can no longer authenticate. Independent
  // of subscription status: billing gates *usage*, suspension gates
  // *access* entirely (abuse/compliance, not non-payment).
  suspendedAt                   DateTime?
  // White-labeling — gated to plans with SubscriptionPlan.whiteLabel=true
  // (checked in the settings action, not enforced at the DB level since a
  // downgrade shouldn't silently wipe a tenant's saved domain).
  customDomain                  String?   @unique
  customDomainVerificationToken String?
  customDomainVerifiedAt        DateTime?
  // Phase 8: tenant-level kill switch for refill reminders — the scheduled
  // job (and the manual "Send now" action) both skip a tenant entirely
  // unless this is on, independent of any individual customer's opt-in.
  refillRemindersEnabled        Boolean   @default(false)
  // Phase 9: the URL segment for this tenant's customer portal
  // (/portal/<slug>) — auto-generated from pharmacyName at signup,
  // owner-editable in Settings > Branding. Unique across the whole
  // platform (portal routing has no other way to resolve which tenant a
  // request is for — see src/app/portal/[slug]).
  portalSlug                    String    @unique
  // Phase 9: tenant-level kill switch for post-sale WhatsApp feedback
  // requests — off by default, same "explicit opt-in" convention as
  // refillRemindersEnabled above.
  feedbackRequestsEnabled       Boolean   @default(false)
  createdAt                     DateTime  @default(now())

  branches      Branch[]
  items         Item[]
  customers     Customer[]
  doctors       Doctor[]
  salesInvoices SalesInvoice[]
  discounts     Discount[]
  users         User[]
  auditLogs     AuditLog[]
  backupLogs    BackupLog[]

  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  grns                  Grn[]
  purchaseReturns       PurchaseReturn[]
  supplierLedgerEntries SupplierLedgerEntry[]
  stockTransfers        StockTransfer[]

  narcoticRegisterEntries NarcoticRegisterEntry[]

  schemes      Scheme[]
  loyaltyTiers LoyaltyTier[]
  coupons      Coupon[]

  customerLedgerEntries CustomerLedgerEntry[]
  whatsappLogs          WhatsAppLog[]

  subscription TenantSubscription?
  apiKeys      ApiKey[]

  wards             Ward[]
  wardAssignments   WardAssignment[]
  indents           Indent[]
  patientAdmissions PatientAdmission[]
  ipdDispenses      IpdDispense[]

  cloudBackupConnections CloudBackupConnection[]

  refillReminders RefillReminder[]

  insuranceProviders InsuranceProvider[]
  insuranceClaims    InsuranceClaim[]

  customerOtps   CustomerOtp[]
  refillRequests RefillRequest[]

  pushSubscriptions PushSubscription[]

  rateContracts RateContract[]

  temperatureLogs TemperatureLog[]

  customerFeedback CustomerFeedback[]

  // Phase 9: franchise/dealer management — a tenant may found at most one
  // group (as franchisor) and belong to at most one group (as a member),
  // never both merged into a single relation since the two roles carry
  // different permissions.
  franchiseGroupOwned FranchiseGroup?
  franchiseMembership FranchiseMember?
  franchiseMembersOwned FranchiseMember[] @relation("FranchiseMemberOwnerTenant")

  gstFilingReminders GstFilingReminder[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Subscription & billing — Phase 6
// ---------------------------------------------------------------------------

// A shared catalog, not tenant data — deliberately has no tenantId and no
// RLS policy (every tenant needs to read the same plan list to self-serve
// signup/upgrade). Only trusted internal code (via the bypass flag) writes
// to it; there's no tenant-facing mutation path.
model SubscriptionPlan {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  priceMonthly     Decimal  @db.Decimal(10, 2)
  maxBranches      Int?
  maxUsers         Int?
  whiteLabel       Boolean  @default(false)
  publicApiAccess  Boolean  @default(false)
  // Enterprise-tier plans skip self-serve Razorpay checkout entirely — the
  // signup/upgrade UI shows a "Talk to sales" CTA instead of a pay button.
  contactSalesOnly Boolean  @default(false)
  // Razorpay's own recurring-billing plan id, created once in the Razorpay
  // dashboard/API per priced tier. Null for the trial tier (no billing) and
  // for the enterprise tier (billed manually, outside Razorpay).
  razorpayPlanId   String?
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

enum TenantSubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

model TenantSubscription {
  id                     String                   @id @default(cuid())
  tenantId               String                   @unique
  planId                 String
  status                 TenantSubscriptionStatus @default(trialing)
  razorpayCustomerId     String?
  razorpaySubscriptionId String?                  @unique
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([planId])
  @@map("tenant_subscriptions")
}

model Branch {
  id                       String   @id @default(cuid())
  tenantId                 String
  name                     String
  licensedAddress          String
  gstin                    String?
  pan                      String?
  drugLicenseRetailNo      String?
  drugLicenseWholesaleNo   String?
  pharmacistName           String?
  pharmacistRegistrationNo String?
  narcoticLicenseNo        String?
  fssaiNo                  String?
  // Keyed by license type (retail, wholesale, narcotic, fssai) -> ISO date
  // string. jsonb rather than one column per license so the Alerts screen's
  // "renewals due soon" scan and the Settings form can both iterate it
  // generically instead of hard-coding a column per license type.
  licenseExpiryDates       Json?
  // A branch-level toggle stands in for a turnover-threshold check — the
  // real GST e-invoice turnover threshold is government policy that
  // changes over time, so it's not hardcoded; an owner flips this on once
  // the branch is actually liable for e-invoicing.
  einvoiceEnabled          Boolean  @default(false)
  // Per-invoice/GRN value threshold above which an e-way bill is
  // auto-attempted. Configurable per branch (state-level e-way bill rules
  // vary), not hardcoded to the common ₹50,000 default.
  ewayBillThreshold        Decimal  @default(50000) @db.Decimal(12, 2)
  createdAt                DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesInvoices   SalesInvoice[]
  purchaseOrders  PurchaseOrder[]
  grns            Grn[]
  batches         Batch[]
  purchaseReturns PurchaseReturn[]

  narcoticRegisterEntries NarcoticRegisterEntry[]
  stockTransfersFrom      StockTransfer[]         @relation("StockTransferFrom")
  stockTransfersTo        StockTransfer[]         @relation("StockTransferTo")

  wards Ward[]

  temperatureLogs TemperatureLog[]
  customerFeedback CustomerFeedback[]

  @@index([tenantId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Item / Batch master
// ---------------------------------------------------------------------------

enum ScheduleClass {
  none
  H
  H1
  X
  G
}

model Item {
  id            String        @id @default(cuid())
  tenantId      String
  name          String
  genericName   String?
  manufacturer  String?
  composition   String?
  scheduleClass ScheduleClass @default(none)
  hsnCode       String?
  taxRate       Decimal       @default(0) @db.Decimal(5, 2)
  unit          String        @default("unit")
  packSize      String?
  reorderLevel  Int           @default(10)
  // Phase 9: flags an item as needing cold-chain storage (vaccines,
  // insulin, etc.) — TemperatureLog entries are recorded per branch (the
  // storage unit), not per item; this flag is what decides whether an
  // out-of-range reading is worth surfacing as an alert at all.
  requiresColdChain Boolean @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches             Batch[]
  salesInvoiceItems   SalesInvoiceItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  grnItems            GrnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  stockTransferItems  StockTransferItem[]
  indentItems         IndentItem[]
  ipdDispenses        IpdDispense[]
  refillReminders     RefillReminder[]

  narcoticRegisterEntries NarcoticRegisterEntry[]
  rateContracts           RateContract[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@map("items")
}

model Batch {
  id           String    @id @default(cuid())
  itemId       String
  // A batch is physically at one branch — it's the GRN that received it (or
  // a stock transfer) that pins it there. The same batch number can exist
  // as separate Batch rows at different branches; a transfer creates a new
  // row at the destination rather than splitting one row across branches.
  branchId     String
  // Phase 7 (Hospital Mode): null means this row is central/branch-level
  // stock (the only case for a retail tenant). Set means this row is
  // ward-scoped stock within that same branch — the same "new row at the
  // destination, never split across locations" principle as branchId
  // above, just one level deeper. An indent issue creates/updates the
  // ward's own Batch row rather than moving the central one.
  wardId       String?
  batchNo      String
  mfgDate      DateTime?
  expiryDate   DateTime
  mrp          Decimal   @db.Decimal(10, 2)
  purchaseRate Decimal   @db.Decimal(10, 2)
  saleRate     Decimal   @db.Decimal(10, 2)
  currentQty   Int       @default(0)
  rackLocation String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  item                Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch              Branch               @relation(fields: [branchId], references: [id])
  ward                Ward?                @relation(fields: [wardId], references: [id])
  salesInvoiceItems   SalesInvoiceItem[]
  grnItems            GrnItem[]
  purchaseReturnItems PurchaseReturnItem[]
  stockTransferItems  StockTransferItem[]
  indentItems         IndentItem[]
  ipdDispenses        IpdDispense[]

  narcoticRegisterEntries NarcoticRegisterEntry[]

  @@index([itemId])
  @@index([itemId, expiryDate])
  @@index([branchId])
  @@index([branchId, itemId, batchNo])
  @@index([wardId])
  @@index([wardId, itemId, batchNo])
  @@map("batches")
}

// ---------------------------------------------------------------------------
// Customer / Doctor
// ---------------------------------------------------------------------------

model Customer {
  id                   String   @id @default(cuid())
  tenantId             String
  name                 String
  phone                String?
  creditLimit          Decimal? @db.Decimal(10, 2)
  // Cached for convenience only — never written to directly by app code.
  // The real balance is always SUM(CustomerLedgerEntry.amount) for this
  // customer (credit sales positive, payments negative); see
  // src/lib/actions/customers.ts.
  outstandingBalance   Decimal  @default(0) @db.Decimal(12, 2)
  // Loyalty tier is computed/reassigned automatically whenever
  // cumulativeSpend crosses a tier threshold (see resolveLoyaltyTier in
  // src/lib/actions/pos.ts) — never set directly through a form.
  loyaltyTierId        String?
  cumulativeSpend      Decimal  @default(0) @db.Decimal(12, 2)
  // Phase 8: per-customer opt-in for automated refill-reminder WhatsApp
  // messages — off by default even when the tenant-level toggle is on, so
  // no customer gets messaged without asking them first.
  refillRemindersOptIn Boolean  @default(false)
  createdAt            DateTime @default(now())

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loyaltyTier     LoyaltyTier?          @relation(fields: [loyaltyTierId], references: [id])
  salesInvoices   SalesInvoice[]
  ledgerEntries   CustomerLedgerEntry[]
  whatsappLogs    WhatsAppLog[]
  refillReminders RefillReminder[]
  otps            CustomerOtp[]
  refillRequests  RefillRequest[]
  rateContracts   RateContract[]
  feedback        CustomerFeedback[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([loyaltyTierId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Customer portal — Phase 9
// ---------------------------------------------------------------------------

/**
 * One row per OTP code issued for customer-portal login. Deliberately a
 * hashed, short-lived, single-use code (never the raw code) — same
 * "never trust a stored secret in plaintext" posture as password/PIN
 * hashing elsewhere in this app — sent via the existing WhatsApp provider
 * (Phase 5), not a new delivery channel.
 */
model CustomerOtp {
  id         String    @id @default(cuid())
  tenantId   String
  customerId String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId, createdAt])
  @@map("customer_otps")
}

enum RefillRequestStatus {
  pending
  fulfilled
  dismissed
}

/**
 * A customer-initiated "please refill this" flag against a past purchase —
 * deliberately NOT a sale. It only ever creates this row; a staff member
 * still rings up the actual refill through the normal POS screen once
 * they've acted on it, exactly like the phase spec requires.
 */
model RefillRequest {
  id          String              @id @default(cuid())
  tenantId    String
  customerId  String
  invoiceId   String?
  note        String?
  status      RefillRequestStatus @default(pending)
  createdAt   DateTime            @default(now())
  fulfilledAt DateTime?

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice  SalesInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@map("refill_requests")
}

/**
 * A staff member's Web Push subscription for the owner mobile PWA — one row
 * per browser/device the user granted notification permission on (a user
 * can have several: phone + desktop). endpoint is unique per browser
 * install, so re-subscribing (e.g. after clearing site data) just creates a
 * fresh row rather than colliding.
 */
model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  authKey   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("push_subscriptions")
}

enum WhatsAppMessageType {
  receipt
  statement
  reminder
  feedback
}

enum WhatsAppStatus {
  sent
  failed
}

model WhatsAppLog {
  id          String              @id @default(cuid())
  tenantId    String
  customerId  String?
  invoiceId   String?
  phone       String
  messageType WhatsAppMessageType
  status      WhatsAppStatus
  // Provider error text, or "not configured" when no WhatsApp API
  // credentials are set — kept distinct from `status` so the UI can show
  // staff *why* a send failed, not just that it did.
  note        String?
  sentAt      DateTime            @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id])
  invoice  SalesInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@index([invoiceId])
  @@map("whatsapp_logs")
}

/**
 * Phase 8: one row per attempted refill reminder for a given customer+item
 * purchase cycle. `lastPurchaseDate` is the anchor purchase the projection
 * was computed from; the unique constraint on
 * (customerId, itemId, lastPurchaseDate) is what actually prevents a
 * duplicate reminder for the same cycle — not a date-window check — so it
 * stays correct even if the projected expectedDate shifts slightly between
 * scheduled runs. Delivery status/note reuse the same WhatsAppLog write as
 * every other WhatsApp message, this table exists purely for the dedupe key
 * and to drive the "next reminder due" read in the UI.
 */
model RefillReminder {
  id               String         @id @default(cuid())
  tenantId         String
  customerId       String
  itemId           String
  lastPurchaseDate DateTime
  expectedDate     DateTime
  status           WhatsAppStatus
  sentAt           DateTime       @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([customerId, itemId, lastPurchaseDate])
  @@index([tenantId])
  @@index([customerId])
  @@map("refill_reminders")
}

enum CustomerLedgerEntryType {
  sale
  payment
}

model CustomerLedgerEntry {
  id            String                  @id @default(cuid())
  tenantId      String
  customerId    String
  type          CustomerLedgerEntryType
  // Signed: credit sales are positive (increase what they owe), payments
  // are negative (decrease what they owe). Outstanding balance for a
  // customer is simply SUM(amount) over their entries.
  amount        Decimal                 @db.Decimal(12, 2)
  referenceId   String?
  referenceType String?
  note          String?
  createdAt     DateTime                @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId, createdAt])
  @@map("customer_ledger_entries")
}

enum SchemeType {
  percent_off
  buy_x_get_y
}

// config jsonb holds type-specific rules:
//   percent_off  -> { percent: number, applicableItemIds?: string[] }
//   buy_x_get_y  -> { buyQty: number, getQty: number, applicableItemIds: string[] }
// An empty/omitted applicableItemIds on percent_off means "all items".
model Scheme {
  id        String     @id @default(cuid())
  tenantId  String
  name      String
  type      SchemeType
  config    Json
  validFrom DateTime
  validTo   DateTime
  active    Boolean    @default(true)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discounts Discount[]

  @@index([tenantId])
  @@index([tenantId, active])
  @@map("schemes")
}

model LoyaltyTier {
  id                 String  @id @default(cuid())
  tenantId           String
  name               String
  minCumulativeSpend Decimal @db.Decimal(12, 2)
  discountPercent    Decimal @db.Decimal(5, 2)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@index([tenantId])
  @@map("loyalty_tiers")
}

enum CouponType {
  percent
  flat
}

model Coupon {
  id                   String     @id @default(cuid())
  tenantId             String
  code                 String
  type                 CouponType
  value                Decimal    @db.Decimal(10, 2)
  validFrom            DateTime
  validTo              DateTime
  usageLimit           Int?
  usageCount           Int        @default(0)
  singleUsePerCustomer Boolean    @default(false)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discounts Discount[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("coupons")
}

/**
 * Phase 9: a negotiated rate for one customer + one item — auto-applied at
 * POS billing in place of the batch's normal saleRate when active
 * (validFrom <= now <= validTo), with a "Contract rate applied" indicator
 * on the cart line (src/components/pos/cart-table.tsx). Rows are kept
 * around after expiry/deactivation for history rather than deleted — the
 * `active` flag plus the date range together decide whether one currently
 * applies (same shape as Scheme above).
 */
model RateContract {
  id           String   @id @default(cuid())
  tenantId     String
  customerId   String
  itemId       String
  contractRate Decimal  @db.Decimal(10, 2)
  validFrom    DateTime
  validTo      DateTime
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, customerId, itemId])
  @@map("rate_contracts")
}

/**
 * Phase 9: manual cold-chain temperature reading for one branch's storage
 * unit (fridge) — not per item. A branch may have items flagged
 * `requiresColdChain`; readings outside the standard 2-8°C vaccine/pharma
 * cold-chain range surface as an out-of-range alert on the Alerts screen
 * (src/lib/actions/alerts.ts). No IoT/sensor integration — entries are
 * typed in by staff, per the phase spec's explicit "manual entry only".
 */
model TemperatureLog {
  id                String   @id @default(cuid())
  tenantId          String
  branchId          String
  temperatureCelsius Decimal @db.Decimal(5, 2)
  recordedAt        DateTime @default(now())
  recordedByUserId  String
  note              String?

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  recordedBy   User   @relation(fields: [recordedByUserId], references: [id])

  @@index([tenantId])
  @@index([branchId, recordedAt])
  @@map("temperature_logs")
}

/**
 * Phase 9: one row per post-sale feedback request — created (with a random
 * unguessable `token`) when a completed sale triggers a WhatsApp feedback
 * link, and filled in (`rating`/`comment`/`submittedAt`) if the customer
 * actually follows the link and submits. The public /feedback/[token]
 * route is unauthenticated (possession of the link is the only "auth"),
 * so this is looked up via basePrisma + the RLS bypass flag, the same
 * pre-login pattern as the customer portal's OTP flow.
 */
model CustomerFeedback {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    String
  invoiceId   String    @unique
  customerId  String?
  token       String    @unique
  rating      Int?
  comment     String?
  requestedAt DateTime  @default(now())
  submittedAt DateTime?

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invoice  SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, branchId, submittedAt])
  @@map("customer_feedback")
}

/**
 * Phase 9: franchise/dealer management — links independent tenants
 * WITHOUT merging their data. Each member tenant's own RLS-protected data
 * (branches, items, sales, everything) stays fully isolated; membership is
 * purely a cross-tenant relationship the franchisor and member both opted
 * into (the franchisor by creating the group, the member by entering its
 * join code). The most architecturally novel Phase 9 item, built last on
 * purpose — see src/lib/actions/franchise.ts for how a franchisor session
 * legally reads aggregate numbers across opted-in members without
 * violating the single-tenant RLS model everything else in this app
 * relies on.
 */
model FranchiseGroup {
  id            String    @id @default(cuid())
  name          String
  // Given to prospective members out-of-band (phone/email) to join —
  // same "unique platform-wide code" shape as Tenant.portalSlug, just
  // random rather than name-derived since it's meant to be shared once,
  // not linked to indefinitely.
  joinCode      String    @unique
  ownerTenantId String    @unique
  // Set when the franchisor last pushed its standardized item list
  // (name/genericName/hsnCode/taxRate only — never stock/pricing) to all
  // current members. A discrete, on-demand sync the franchisor can
  // re-trigger, not an ongoing feed — see pushStandardizedItemList.
  itemListPushedAt DateTime?
  createdAt     DateTime  @default(now())

  ownerTenant Tenant             @relation(fields: [ownerTenantId], references: [id], onDelete: Cascade)
  members     FranchiseMember[]

  @@map("franchise_groups")
}

model FranchiseMember {
  id               String    @id @default(cuid())
  franchiseGroupId String
  tenantId         String    @unique
  // Denormalized copy of franchiseGroup.ownerTenantId, set once at join
  // time and never changed. This isn't for query convenience — it exists
  // to break a real Postgres limitation: a naive RLS policy design has
  // franchise_groups' policy check membership via a subquery into
  // franchise_members, and franchise_members' policy check ownership via
  // a subquery into franchise_groups. Postgres detects that mutual
  // reference as infinite recursion (error 42P17) the moment either
  // policy is evaluated. Storing the owner directly here means
  // franchise_members' own policy never has to look at franchise_groups
  // at all, breaking the cycle — see the migration for the actual
  // policies.
  ownerTenantId    String
  // The member's own explicit opt-in for the franchisor's sales/margin
  // rollup report to include this tenant's aggregate numbers — off by
  // default, the member can turn it off again at any time. Deliberately
  // separate from membership itself: joining a group is not the same as
  // agreeing to share sales data.
  rollupOptIn      Boolean   @default(false)
  joinedAt         DateTime  @default(now())

  franchiseGroup FranchiseGroup @relation(fields: [franchiseGroupId], references: [id], onDelete: Cascade)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerTenant    Tenant         @relation("FranchiseMemberOwnerTenant", fields: [ownerTenantId], references: [id], onDelete: Cascade)

  @@index([franchiseGroupId])
  @@index([ownerTenantId])
  @@map("franchise_members")
}

model Doctor {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  registrationNo String?
  clinicName     String?
  createdAt      DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesInvoices SalesInvoice[]

  narcoticRegisterEntries NarcoticRegisterEntry[]

  @@index([tenantId])
  @@map("doctors")
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

enum PaymentMode {
  cash
  upi
  card
  credit
  // Phase 8: cashless insurance/TPA billing — same "owed, not yet
  // collected" idea as credit, except the debtor is an InsuranceProvider
  // (tracked via InsuranceClaim) instead of the customer's own ledger.
  insurance
}

enum InvoiceStatus {
  completed
  cancelled
}

model SalesInvoice {
  id                      String        @id @default(cuid())
  tenantId                String
  branchId                String
  customerId              String?
  doctorId                String?
  patientName             String?
  patientAge              Int?
  invoiceNo               String
  invoiceDate             DateTime      @default(now())
  // Client-generated UUID set only for a sale that was queued offline and
  // synced later — lets a retried sync (e.g. the network drops again right
  // after the server commits but before the client sees the response)
  // replay safely instead of double-billing. Null for every sale rung up
  // while online.
  offlineClientId         String?       @unique
  subtotal                Decimal       @db.Decimal(12, 2)
  taxAmount               Decimal       @db.Decimal(12, 2)
  discountAmount          Decimal       @default(0) @db.Decimal(12, 2)
  total                   Decimal       @db.Decimal(12, 2)
  paymentMode             PaymentMode
  status                  InvoiceStatus @default(completed)
  // Scan/photo of the physical prescription, attached for Schedule H/H1/X
  // sales. Optional — capture is encouraged, not enforced, per spec.
  prescriptionImageUrl    String?
  // The specific Pharmacist-role user who electronically signed off on a
  // regulated-drug dispense, separate from whichever Counter Staff user
  // actually rang up the sale (session.user.id if a Pharmacist is at the
  // till; the re-authenticating pharmacist's id otherwise). Null for
  // invoices with no Schedule H/H1/X lines.
  pharmacistSignoffUserId String?
  pharmacistSignoffAt     DateTime?
  // Populated asynchronously after the sale completes — a failed/slow GSP
  // call must never block or fail the checkout transaction itself. Null
  // until (and unless) generation succeeds; a manual retry action is
  // available from the receipt screen.
  einvoiceIrn             String?
  einvoiceAckNo           String?
  // The signed QR payload string returned by the IRP — rendered as an
  // actual QR image client-side (via the `qrcode` package already used for
  // MFA setup), not stored as an image.
  einvoiceQrData          String?
  ewayBillNo              String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch    @relation(fields: [branchId], references: [id])
  customer          Customer? @relation(fields: [customerId], references: [id])
  doctor            Doctor?   @relation(fields: [doctorId], references: [id])
  pharmacistSignoff User?     @relation("SalesInvoicePharmacistSignoff", fields: [pharmacistSignoffUserId], references: [id])

  items                   SalesInvoiceItem[]
  discounts               Discount[]
  narcoticRegisterEntries NarcoticRegisterEntry[]
  whatsappLogs            WhatsAppLog[]
  insuranceClaim          InsuranceClaim?
  refillRequests          RefillRequest[]
  feedback                CustomerFeedback?

  @@unique([tenantId, invoiceNo])
  @@index([tenantId, invoiceDate])
  @@map("sales_invoices")
}

// ---------------------------------------------------------------------------
// Insurance / TPA cashless billing — Phase 8
// ---------------------------------------------------------------------------

model InsuranceProvider {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  // The TPA's own code for this insurer, where distinct from the insurer
  // itself (many Indian health policies are administered by a separate
  // TPA) — free text, not validated against any registry.
  tpaCode      String?
  contactPhone String?
  contactEmail String?
  // Inactive providers stay for historical claims (never deleted) but drop
  // out of the POS payment-mode picker's provider list.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claims InsuranceClaim[]

  @@index([tenantId])
  @@map("insurance_providers")
}

enum InsuranceClaimStatus {
  pending
  approved
  rejected
  settled
}

/**
 * One row per insurance-billed SalesInvoice (paymentMode = "insurance") —
 * the same "owed, not yet collected" relationship credit sales already
 * have via CustomerLedgerEntry, except the debtor is the TPA/insurer, so it
 * gets its own claim-lifecycle model instead of overloading the customer
 * ledger with a payer that isn't a customer.
 */
model InsuranceClaim {
  id                  String               @id @default(cuid())
  tenantId            String
  invoiceId           String               @unique
  insuranceProviderId String
  claimNumber         String?
  // What's actually billed to the insurer — invoice total minus whatever
  // co-pay the patient paid at the counter.
  claimedAmount       Decimal              @db.Decimal(12, 2)
  coPayAmount         Decimal              @default(0) @db.Decimal(12, 2)
  status              InsuranceClaimStatus @default(pending)
  // Set only once status moves to "settled" — the TPA doesn't always pay
  // the full claimedAmount (deductions, partial approval), so this is
  // tracked separately rather than assumed equal.
  settledAmount       Decimal?             @db.Decimal(12, 2)
  settledAt           DateTime?
  rejectionReason     String?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice           SalesInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  insuranceProvider InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])

  @@index([tenantId])
  @@index([insuranceProviderId])
  @@map("insurance_claims")
}

model SalesInvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  itemId         String
  batchId        String
  qty            Int
  rate           Decimal @db.Decimal(10, 2)
  taxRate        Decimal @db.Decimal(5, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)

  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item      Item         @relation(fields: [itemId], references: [id])
  batch     Batch        @relation(fields: [batchId], references: [id])
  discounts Discount[]

  @@index([invoiceId])
  @@index([itemId])
  @@index([batchId])
  @@map("sales_invoice_items")
}

enum DiscountType {
  item
  bill
  scheme
  loyalty
  coupon
}

model Discount {
  id               String       @id @default(cuid())
  tenantId         String
  invoiceId        String
  invoiceItemId    String?
  type             DiscountType
  // The rate as entered/configured — a percent or a flat rupee value per
  // isPercent. Kept for audit ("what was typed/configured"), but NOT the
  // actual rupee amount applied (which can differ after capping when
  // multiple bill-level discounts stack) — use `amount` for that.
  amountOrPercent  Decimal      @db.Decimal(10, 2)
  isPercent        Boolean      @default(true)
  // The actual rupee amount this discount contributed to the sale, after
  // any stacking/capping — what the discount report sums.
  amount           Decimal      @default(0) @db.Decimal(10, 2)
  // Set only when type is "scheme" / "coupon" respectively — links the
  // discount row back to the offer that produced it, for reporting.
  schemeId         String?
  couponId         String?
  appliedByUserId  String
  approvedByUserId String?
  createdAt        DateTime     @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     SalesInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItem SalesInvoiceItem? @relation(fields: [invoiceItemId], references: [id])
  scheme      Scheme?           @relation(fields: [schemeId], references: [id])
  coupon      Coupon?           @relation(fields: [couponId], references: [id])
  appliedBy   User              @relation("DiscountAppliedBy", fields: [appliedByUserId], references: [id])
  approvedBy  User?             @relation("DiscountApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@index([schemeId])
  @@index([couponId])
  @@map("discounts")
}

// ---------------------------------------------------------------------------
// Users / Auth
// ---------------------------------------------------------------------------

enum UserRole {
  owner
  pharmacist
  counter_staff
  // Phase 7 (Hospital Mode) — only assignable/reachable on a tenant with
  // tenantType 'hospital'. ward_nurse: creates Indents and records IPD
  // dispenses/returns for their assigned ward(s) only, no access to
  // purchasing or retail billing. ward_pharmacist: approves/issues
  // Indents, and everywhere the existing "pharmacist" role is checked
  // (rbac.ts, POS prescription sign-off) it is treated identically — a
  // hospital's central/OPD pharmacist, not a separate permission set.
  ward_nurse
  ward_pharmacist
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String
  role         UserRole
  phone        String?
  licenseNo    String?
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  // Per-user UI language (Phase 10.1) — deliberately independent of the
  // tenant's own settings, since staff on the same counter may each want
  // a different language. "en" | "hi" today; adding a language means
  // adding a messages/<locale>.json file and this column accepting the
  // new value, not touching component code.
  locale       String   @default("en")
  // Phase 10.3: set once a new Counter Staff/Pharmacist user completes the
  // guided in-app walkthrough on first login — a lightweight signal for
  // the Owner (surfaced on the staff list), not a training record with any
  // enforcement behind it.
  certifiedAt  DateTime?
  // Phase 10.5: per-user high-contrast display preference — a personal
  // accessibility setting, same reasoning as `locale` above (independent
  // per staff member, not tenant-wide).
  highContrast Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs         AuditLog[]
  discountsApplied  Discount[] @relation("DiscountAppliedBy")
  discountsApproved Discount[] @relation("DiscountApprovedBy")

  purchaseOrdersCreated  PurchaseOrder[]  @relation("PurchaseOrderCreatedBy")
  grnsReceived           Grn[]            @relation("GrnReceivedBy")
  purchaseReturnsCreated PurchaseReturn[] @relation("PurchaseReturnCreatedBy")

  salesInvoicesSignedOff   SalesInvoice[]          @relation("SalesInvoicePharmacistSignoff")
  narcoticEntriesDispensed NarcoticRegisterEntry[] @relation("NarcoticEntryDispensedBy")

  stockTransfersRequested StockTransfer[] @relation("StockTransferRequestedBy")
  stockTransfersApproved  StockTransfer[] @relation("StockTransferApprovedBy")

  wardAssignments      WardAssignment[]
  indentsRequested     Indent[]         @relation("IndentRequestedBy")
  indentsApproved      Indent[]         @relation("IndentApprovedBy")
  ipdDispensesRecorded IpdDispense[]    @relation("IpdDispenseDispensedBy")

  cloudBackupConnectionsMade CloudBackupConnection[]

  pushSubscriptions PushSubscription[]

  temperatureLogsRecorded TemperatureLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Audit / Backup
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

enum BackupDestination {
  local
  manual
  google_drive
  onedrive
}

enum BackupStatus {
  success
  failed
}

model BackupLog {
  id          String            @id @default(cuid())
  tenantId    String
  destination BackupDestination
  status      BackupStatus
  createdAt   DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("backup_logs")
}

// ---------------------------------------------------------------------------
// Purchase & Inventory — Phase 2
// ---------------------------------------------------------------------------

model Supplier {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String
  gstin              String?
  address            String?
  paymentTermsDays   Int?
  // Cached for convenience only — never written to directly by app code.
  // The real balance is always SUM(SupplierLedgerEntry.amount) for this
  // supplier (purchases positive, payments/returns negative); see
  // src/lib/actions/suppliers.ts.
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt          DateTime @default(now())

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]
  grns            Grn[]
  purchaseReturns PurchaseReturn[]
  ledgerEntries   SupplierLedgerEntry[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  draft
  sent
  received
  cancelled
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  tenantId        String
  branchId        String
  supplierId      String
  status          PurchaseOrderStatus @default(draft)
  createdAt       DateTime            @default(now())
  createdByUserId String

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id])
  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User     @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id])

  items PurchaseOrderItem[]
  grns  Grn[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  itemId          String
  qty             Int
  rate            Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model Grn {
  id                  String   @id @default(cuid())
  tenantId            String
  // Which branch physically received the goods — new in Phase 4. Backfilled
  // for existing rows to the tenant's pre-Phase-4 single branch.
  branchId            String
  purchaseOrderId     String?
  supplierId          String
  supplierInvoiceNo   String
  supplierInvoiceDate DateTime
  receivedAt          DateTime @default(now())
  receivedByUserId    String
  ewayBillNo          String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  receivedBy    User           @relation("GrnReceivedBy", fields: [receivedByUserId], references: [id])

  items           GrnItem[]
  purchaseReturns PurchaseReturn[]

  @@index([tenantId])
  @@index([tenantId, receivedAt])
  @@index([purchaseOrderId])
  @@index([branchId])
  @@map("grns")
}

model GrnItem {
  id                    String    @id @default(cuid())
  grnId                 String
  itemId                String
  // Set in the same transaction that creates/updates the Batch this row
  // resulted in — a GrnItem never exists without its Batch being real.
  batchId               String
  batchNo               String
  mfgDate               DateTime?
  expiryDate            DateTime
  mrp                   Decimal   @db.Decimal(10, 2)
  // The invoiced/list rate per unit for the qty actually billed — unchanged
  // meaning even when a scheme applies, so this always matches what the
  // supplier's paper invoice says. Scheme benefit is layered on top via the
  // fields below rather than baked into this number.
  rate                  Decimal   @db.Decimal(10, 2)
  qty                   Int
  // Phase 8: manufacturer/distributor scheme tracking. Bonus units received
  // at zero additional cost (e.g. a "10+1" scheme) — real stock, so
  // createGrn folds these into the batch's received qty and blends them
  // into its purchaseRate; unlike schemeDiscountPercent below this isn't
  // just informational.
  freeQty               Int       @default(0)
  // A cash/trade discount % negotiated on this line's invoiced value.
  // Deliberately informational only (surfaced in the Scheme Benefits
  // report) rather than silently rewriting the supplier ledger amount or
  // the batch's cost — those already have well-established call sites
  // elsewhere (createGrn's ledger entry, the e-way bill threshold check)
  // that a text-adjacent percent field shouldn't reach into un-asked.
  schemeDiscountPercent Decimal?  @db.Decimal(5, 2)
  // Free-text description of the scheme itself (e.g. "Diwali 10+1", a
  // distributor's scheme code) — purely for the pharmacist's own record and
  // the Scheme Benefits report, never parsed.
  schemeNote            String?

  grn   Grn   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item  Item  @relation(fields: [itemId], references: [id])
  batch Batch @relation(fields: [batchId], references: [id])

  @@index([grnId])
  @@index([itemId])
  @@map("grn_items")
}

model PurchaseReturn {
  id              String   @id @default(cuid())
  tenantId        String
  // Which branch's stock this return decrements — new in Phase 4,
  // backfilled for existing rows from the tenant's pre-Phase-4 single
  // branch. Independent of grnId since a return can be standalone.
  branchId        String
  grnId           String?
  supplierId      String
  returnDate      DateTime @default(now())
  reason          String?
  totalAmount     Decimal  @db.Decimal(12, 2)
  createdByUserId String

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id])
  grn       Grn?     @relation(fields: [grnId], references: [id])
  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User     @relation("PurchaseReturnCreatedBy", fields: [createdByUserId], references: [id])

  items PurchaseReturnItem[]

  @@index([tenantId])
  @@index([tenantId, returnDate])
  @@index([grnId])
  @@index([branchId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               String  @id @default(cuid())
  purchaseReturnId String
  itemId           String
  batchId          String
  qty              Int
  rate             Decimal @db.Decimal(10, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  item           Item           @relation(fields: [itemId], references: [id])
  batch          Batch          @relation(fields: [batchId], references: [id])

  @@index([purchaseReturnId])
  @@map("purchase_return_items")
}

enum SupplierLedgerEntryType {
  purchase
  payment
  return
}

model SupplierLedgerEntry {
  id            String                  @id @default(cuid())
  tenantId      String
  supplierId    String
  type          SupplierLedgerEntryType
  // Signed: purchases are positive (increase what we owe), payments and
  // returns are negative (decrease what we owe). Outstanding balance for a
  // supplier is simply SUM(amount) over their entries.
  amount        Decimal                 @db.Decimal(12, 2)
  referenceId   String?
  referenceType String?
  note          String?
  createdAt     DateTime                @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([supplierId, createdAt])
  @@map("supplier_ledger_entries")
}

// ---------------------------------------------------------------------------
// Multi-branch — Phase 4
// ---------------------------------------------------------------------------

enum StockTransferStatus {
  pending
  approved
  completed
  rejected
}

// Manual request/approve flow between two branches of the same tenant.
// fromBranch is the source (fulfilling) branch; toBranch is the branch that
// requested stock. Approval and stock movement happen atomically in the
// same action — "approved" stays a defined status for the audit trail, but
// a transfer moves straight from pending to completed rather than resting
// in "approved" first; there is no separate ship/receive step in this MVP.
model StockTransfer {
  id                String              @id @default(cuid())
  tenantId          String
  fromBranchId      String
  toBranchId        String
  status            StockTransferStatus @default(pending)
  requestedByUserId String
  approvedByUserId  String?
  createdAt         DateTime            @default(now())
  completedAt       DateTime?

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranch  Branch @relation("StockTransferFrom", fields: [fromBranchId], references: [id])
  toBranch    Branch @relation("StockTransferTo", fields: [toBranchId], references: [id])
  requestedBy User   @relation("StockTransferRequestedBy", fields: [requestedByUserId], references: [id])
  approvedBy  User?  @relation("StockTransferApprovedBy", fields: [approvedByUserId], references: [id])

  items StockTransferItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String @id @default(cuid())
  transferId String
  itemId     String
  batchId    String
  qty        Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     Item          @relation(fields: [itemId], references: [id])
  batch    Batch         @relation(fields: [batchId], references: [id])

  @@index([transferId])
  @@map("stock_transfer_items")
}

// ---------------------------------------------------------------------------
// Compliance — Phase 3
// ---------------------------------------------------------------------------

// Tamper-evident narcotic (Schedule X) dispense register. Insert-only at the
// application level — no update/delete server actions exist for this model.
// A correction is a second row with reversalOfId pointing at the original;
// the original itself is never edited or removed.
model NarcoticRegisterEntry {
  id                String   @id @default(cuid())
  tenantId          String
  branchId          String
  invoiceId         String
  itemId            String
  batchId           String
  qty               Int
  doctorId          String?
  patientName       String?
  dispensedByUserId String
  dispensedAt       DateTime @default(now())
  // Present only on a reversal row; points at the entry it corrects. Unique
  // so an original can be reversed at most once.
  reversalOfId      String?  @unique

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [branchId], references: [id])
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id])
  item        Item         @relation(fields: [itemId], references: [id])
  batch       Batch        @relation(fields: [batchId], references: [id])
  doctor      Doctor?      @relation(fields: [doctorId], references: [id])
  dispensedBy User         @relation("NarcoticEntryDispensedBy", fields: [dispensedByUserId], references: [id])

  reversalOf NarcoticRegisterEntry? @relation("NarcoticEntryReversal", fields: [reversalOfId], references: [id])
  reversedBy NarcoticRegisterEntry? @relation("NarcoticEntryReversal")

  @@index([tenantId])
  @@index([tenantId, dispensedAt])
  @@index([invoiceId])
  @@map("narcotic_register_entries")
}

// ---------------------------------------------------------------------------
// Platform staff & public API — Phase 6
// ---------------------------------------------------------------------------

// Platform operator, not a tenant user — deliberately has no tenantId and
// sits outside the RLS system entirely (there is no tenant to scope to).
// Authenticated through a completely separate session mechanism from
// tenant users (see src/lib/admin-auth.ts) so a compromised tenant session
// can never reach this table or its console.
model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("super_admins")
}

// A generated key for the versioned public REST API (/api/v1/...). Only the
// SHA-256 hash is stored — the plaintext key is shown once, at creation
// time, the same way GitHub/Stripe-style API keys work.
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  keyHash    String    @unique
  // First few characters of the plaintext key, kept only for the tenant to
  // recognize which key is which in a list — never enough to reconstruct it.
  keyPrefix  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// Hospital Mode — Phase 7
//
// A tenant-level toggle (Tenant.tenantType), not a fork of the product: a
// retail tenant never has rows in any table below, and every route/nav item
// that reaches them is unreachable (notFound(), not just hidden) unless
// tenantType is 'hospital'. A hospital's OPD counter keeps using the exact
// same POS/SalesInvoice path as retail; everything here is the IPD side on
// top of it.
// ---------------------------------------------------------------------------

enum WardType {
  icu
  ot
  general
  pharmacy_substore
}

// A Ward is effectively its own small stock location one level deeper than
// Branch (see Batch.wardId) — created under a Branch, never spanning branches.
model Ward {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  type      WardType
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  batches           Batch[]
  wardAssignments   WardAssignment[]
  indents           Indent[]
  patientAdmissions PatientAdmission[]

  @@index([tenantId])
  @@index([branchId])
  @@map("wards")
}

// Which ward(s) a Ward Nurse (or Ward/Duty Pharmacist) is assigned to —
// server-side enforcement point for "a nurse assigned to ICU cannot see or
// act on General Ward data". Owner/Pharmacist/Ward Pharmacist are not
// restricted by this table; it only narrows ward_nurse.
model WardAssignment {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  wardId   String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ward   Ward   @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([userId, wardId])
  @@index([tenantId])
  @@index([userId])
  @@index([wardId])
  @@map("ward_assignments")
}

enum IndentStatus {
  pending
  approved
  partially_issued
  issued
  rejected
}

// Ward-side stock request, approved/issued by the central pharmacy. Modeled
// on StockTransfer (Phase 4) — the difference is a nurse requests an item
// and quantity, not a specific batch; the pharmacist picks the batch (FEFO,
// with override) at issue time.
model Indent {
  id                String       @id @default(cuid())
  tenantId          String
  wardId            String
  requestedByUserId String
  status            IndentStatus @default(pending)
  createdAt         DateTime     @default(now())
  approvedByUserId  String?
  approvedAt        DateTime?

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward        Ward   @relation(fields: [wardId], references: [id])
  requestedBy User   @relation("IndentRequestedBy", fields: [requestedByUserId], references: [id])
  approvedBy  User?  @relation("IndentApprovedBy", fields: [approvedByUserId], references: [id])

  items IndentItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([wardId])
  @@map("indents")
}

model IndentItem {
  id           String  @id @default(cuid())
  indentId     String
  itemId       String
  // Null at request time (a nurse requests an item, not a specific batch).
  // Filled in at issue time with the *source* (central) batch FEFO-selected
  // to fulfill this line, for traceability — matches how GrnItem/
  // StockTransferItem/SalesInvoiceItem all reference the batch a
  // transaction actually moved stock against.
  batchId      String?
  qtyRequested Int
  qtyIssued    Int     @default(0)

  indent Indent @relation(fields: [indentId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id])
  batch  Batch? @relation(fields: [batchId], references: [id])

  @@index([indentId])
  @@index([itemId])
  @@map("indent_items")
}

// Deliberately minimal — not an EMR. Just enough to tag IPD dispenses to a
// real patient/stay; an external HIS is what builds the actual hospital
// bill from the consumption records this produces (see IpdDispense).
model PatientAdmission {
  id           String    @id @default(cuid())
  tenantId     String
  admissionRef String
  patientName  String
  wardId       String
  admittedAt   DateTime  @default(now())
  dischargedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ward   Ward   @relation(fields: [wardId], references: [id])

  dispenses IpdDispense[]

  @@unique([tenantId, admissionRef])
  @@index([tenantId])
  @@index([wardId])
  @@map("patient_admissions")
}

// A consumption record against an admission, dispensed directly from the
// ward's own stock (no separate transfer step, same discipline as POS
// completeSale decrementing its branch's Batch directly). Does NOT create a
// SalesInvoice — IPD consumption feeds an external HIS's own bill, not this
// app's billing. returnedQty supports the unused-medicine return workflow
// without a separate return entity.
model IpdDispense {
  id                String   @id @default(cuid())
  tenantId          String
  admissionId       String
  itemId            String
  batchId           String
  qty               Int
  dispensedByUserId String
  dispensedAt       DateTime @default(now())
  returnedQty       Int      @default(0)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admission   PatientAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  item        Item             @relation(fields: [itemId], references: [id])
  batch       Batch            @relation(fields: [batchId], references: [id])
  dispensedBy User             @relation("IpdDispenseDispensedBy", fields: [dispensedByUserId], references: [id])

  @@index([tenantId])
  @@index([admissionId])
  @@map("ipd_dispenses")
}

// ---------------------------------------------------------------------------
// Cloud backup — Phase 8
// ---------------------------------------------------------------------------

enum CloudBackupProvider {
  google_drive
  onedrive
}

// One OAuth connection per tenant per provider. Tokens are encrypted at
// rest with the same AES-256-GCM helper (src/lib/backup-crypto.ts) the
// backup file contents themselves already use — not a second encryption
// scheme. A scheduled/manual backup run uploads to every row here that
// exists for the tenant; disconnecting is just deleting the row.
model CloudBackupConnection {
  id                String              @id @default(cuid())
  tenantId          String
  provider          CloudBackupProvider
  accessTokenEnc    String
  refreshTokenEnc   String
  expiresAt         DateTime
  connectedByUserId String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedBy User   @relation(fields: [connectedByUserId], references: [id])

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("cloud_backup_connections")
}

// ---------------------------------------------------------------------------
// Drug interaction & duplicate-therapy safety alerts — Phase 10.2
// ---------------------------------------------------------------------------

enum InteractionSeverity {
  caution
  warning
}

// A small, curated starter set of well-known, clinically-significant
// interaction pairs — explicitly NOT a comprehensive drug-interaction
// database (out of scope per the phase spec). A shared reference catalog,
// not tenant data — same reasoning as SubscriptionPlan above: every tenant
// needs to check against the same rule list, nobody edits it through the
// app, so it deliberately has no tenantId and no RLS policy. Only trusted
// internal seeding writes to it.
//
// compositionA/compositionB are matched case-insensitively against
// Item.composition at billing time, checked in both directions, so each
// pair only needs to be seeded once.
model InteractionRule {
  id           String              @id @default(cuid())
  compositionA String
  compositionB String
  severity     InteractionSeverity
  description  String
  createdAt    DateTime            @default(now())

  @@map("interaction_rules")
}

// ---------------------------------------------------------------------------
// Proactive compliance nudges — Phase 10.4
// ---------------------------------------------------------------------------

// A tenant-configured GST filing reminder date, per the phase spec's
// explicit instruction: the actual filing deadline is never computed from
// GST rules here (filing cadence/jurisdiction specifics vary too much) —
// the tenant just types in the date(s) that matter to them, with how many
// days ahead of each one to start nudging. Surfaced on the dashboard the
// same way the existing (Phase 3) license-expiry reminder already is.
model GstFilingReminder {
  id        String   @id @default(cuid())
  tenantId  String
  label     String
  dueDate   DateTime
  leadDays  Int      @default(7)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("gst_filing_reminders")
}
